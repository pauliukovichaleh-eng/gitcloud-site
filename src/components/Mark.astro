---
// Znak ekosystemu GitCloud: sześciokąt rozwarty w literę G ścieżką płytki, węzeł na końcu (ten sam rysunek co w panelu).
interface Props { size?: number; class?: string }
const { size = 32, class: cls = '' } = Astro.props;
const id = 'gm' + Math.random().toString(36).slice(2, 8);
---
<svg class={`mark ${cls}`} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id={id} gradientUnits="userSpaceOnUse" x1="4" y1="4" x2="28" y2="28">
      <stop offset="0" stop-color="#5fb8c2" /><stop offset=".6" stop-color="#3f97a2" /><stop offset="1" stop-color="#b88bd0" />
    </linearGradient>
  </defs>
  <path class="mark-ghost" d="M27.3 9.5 16 3 4.7 9.5v13L16 29l11.3-6.5V16H17" />
  <path class="mark-g" stroke={`url(#${id})`} pathLength="100" d="M27.3 9.5 16 3 4.7 9.5v13L16 29l11.3-6.5V16H17" />
  <circle class="mark-node" cx="16.6" cy="16" r="2.4" />
</svg>
