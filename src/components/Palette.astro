---
// Paleta poleceń (Ctrl+K lub "/", na telefonie przycisk lupy w nagłówku): sekcje, realizacje, polecenia, języki.
// Lista budowana przy buildzie, wyszukiwanie po stronie przeglądarki bez zewnętrznych skryptów.
import { ordered, localize } from '../lib/data';
import { t, home, LANGS, type Lang } from '../i18n';

interface Props { lang: Lang; altPaths?: Partial<Record<Lang, string>> }
const { lang, altPaths } = Astro.props;
const T: any = t(lang);
const P = T.pal;
const base = home(lang);
const EMAIL = 'pauliukovichaleh@gmail.com';
const LNAME: Record<Lang, string> = { pl: 'Polski', en: 'English', ru: 'Русский' };
type Item = { g: string; t: string; s?: string; href?: string; act?: string; k?: string };
const items: Item[] = [
  ...P.secs.map(([id, name]: string[]) => ({ g: P.g.sec, t: name, href: `${base}#${id}`, k: id })),
  ...ordered.map((p0) => { const p = localize(p0, lang); return { g: P.g.proj, t: p.title, s: p.stack.slice(0, 3).join(' · '), href: `${base}#p-${p.slug}`, k: `${p.slug} ${p.stack.join(' ')}` }; }),
  { g: P.g.act, t: P.mail, s: EMAIL, href: `mailto:${EMAIL}`, k: 'mail email kontakt' },
  { g: P.g.act, t: P.copy, s: EMAIL, act: 'copy', k: 'mail email copy' },
  { g: P.g.act, t: P.cv, s: 'PDF', href: T.cv.file, k: 'cv pdf resume' },
  { g: P.g.act, t: P.privacy, href: lang === 'pl' ? '/privacy.html' : `/${lang}/privacy.html`, k: 'privacy rodo gdpr' },
  ...LANGS.filter((l) => l !== lang).map((l) => ({ g: P.g.lang, t: LNAME[l], s: l.toUpperCase(), href: altPaths?.[l] || home(l), k: `lang ${l}` })),
];
---
<dialog class="pal" id="pal" aria-label={P.aria} data-email={EMAIL}>
  <div class="pal-in">
    <div class="pal-q">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
      <input type="text" id="pal-q" placeholder={P.ph} autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="pal-list" aria-autocomplete="list" />
      <kbd class="mono">Esc</kbd>
    </div>
    <ul class="pal-list" id="pal-list" role="listbox" aria-label={P.aria}>
      {items.map((it, i) => (
        <li role="option" id={`pal-o${i}`} data-g={it.g} data-href={it.href} data-act={it.act} data-k={`${it.t} ${it.s || ''} ${it.k || ''}`.toLowerCase()}>
          <span class="pal-g mono">{it.g}</span><b>{it.t}</b>{it.s && <i class="mono">{it.s}</i>}
        </li>
      ))}
    </ul>
    <p class="pal-empty" hidden>{P.empty}</p>
    <p class="pal-hint mono">{P.hint}</p>
  </div>
</dialog>

<script>
  const pal = document.getElementById('pal') as HTMLDialogElement | null;
  if (pal) {
    const q = pal.querySelector<HTMLInputElement>('#pal-q')!;
    const opts = Array.from(pal.querySelectorAll<HTMLLIElement>('li[role=option]'));
    const empty = pal.querySelector<HTMLElement>('.pal-empty')!;
    let cur = 0;
    // bez polskich znaków i wielkości liter: "uslugi" znajdzie "Usługi"
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ł/g, 'l');
    const keys = opts.map((o) => norm(o.dataset.k || ''));
    const vis = () => opts.filter((o) => !o.hidden);
    const mark = (i: number) => {
      const v = vis(); if (!v.length) return;
      cur = (i + v.length) % v.length;
      opts.forEach((o) => o.setAttribute('aria-selected', 'false'));
      v[cur].setAttribute('aria-selected', 'true');
      q.setAttribute('aria-activedescendant', v[cur].id);
      v[cur].scrollIntoView({ block: 'nearest' });
    };
    const filter = () => {
      const words = norm(q.value).split(/\s+/).filter(Boolean);
      opts.forEach((o, i) => { o.hidden = !words.every((w) => keys[i].includes(w)); });
      // nagłówek grupy tylko przy pierwszym widocznym elemencie grupy
      let last = '';
      vis().forEach((o) => { o.classList.toggle('first', o.dataset.g !== last); last = o.dataset.g || ''; });
      empty.hidden = vis().length > 0;
      mark(0);
    };
    const open = () => { if (pal.open) return; q.value = ''; filter(); pal.showModal(); q.focus(); };
    const run = (o?: HTMLLIElement) => {
      if (!o) return;
      pal.close();
      if (o.dataset.act === 'copy') { navigator.clipboard?.writeText(pal.dataset.email || '').then(() => document.dispatchEvent(new CustomEvent('gc-toast')), () => {}); return; }
      const h = o.dataset.href; if (!h) return;
      if (h.endsWith('.pdf')) { window.open(h, '_blank', 'noopener'); return; }
      const u = new URL(h, location.href);
      if (u.pathname === location.pathname && u.hash) { if (location.hash === u.hash) dispatchEvent(new HashChangeEvent('hashchange')); else location.hash = u.hash; }
      else location.href = h;
    };
    q.addEventListener('input', filter);
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); mark(cur + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); mark(cur - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); run(vis()[cur]); }
    });
    opts.forEach((o) => {
      o.addEventListener('click', () => run(o));
      o.addEventListener('pointermove', () => { const i = vis().indexOf(o); if (i !== cur) mark(i); });
    });
    pal.addEventListener('click', (e) => { if (e.target === pal) pal.close(); });
    document.addEventListener('keydown', (e) => {
      const tg = e.target as HTMLElement;
      const typing = tg.closest('input, textarea, [contenteditable]') && tg !== q;
      if ((e.key === 'k' || e.key === 'K') && (e.ctrlKey || e.metaKey)) { e.preventDefault(); pal.open ? pal.close() : open(); }
      else if (e.key === '/' && !typing && !pal.open) { e.preventDefault(); open(); }
    });
    document.querySelectorAll('[data-pal]').forEach((b) => b.addEventListener('click', open));
  }
</script>
