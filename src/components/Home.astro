---
import { DYZ, dyzPath } from '../i18n/dyzurny';
// Strona główna w jednym z trzech języków (pl /, en /en/, ru /ru/). Teksty: src/i18n/*.ts, projekty: lib/data localize().
import Base from '../layouts/Base.astro';
import EcoMap from './EcoMap.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectDialog from './ProjectDialog.astro';
import { ordered as orderedPl, projects, anchor, has, localize, projectPath } from '../lib/data';
import stats from '../data/stats.json';
import { zmiany, zmianyPath } from '../lib/zmiany';
import { t, home, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T: any = t(lang);
const SITE = 'https://gitcloud.pl';
const URL0 = `${SITE}${home(lang)}`;
const EMAIL = 'pauliukovichaleh@gmail.com';
const ordered = orderedPl.map((p) => localize(p, lang));
const categories = T.mod.categories as Record<string, string>;
const count = (c: string) => projects.filter((p) => p.category === c).length;
const pj = (slug: string) => (has(slug) ? `#${anchor(slug)}` : '');
const layerLinks = [   // jak T.arch.layers: interfejs, agenci, dane
  [pj('panel-operacyjny'), pj('pilot-esp32'), '#agenci'],
  [pj('agenci-ai'), pj('panel-operacyjny'), ''],
  ['', '', pj('platforma-danych')],
];
// Interfejsy: prawdziwe ekrany na danych przykładowych (klucz, plik, szerokość, wysokość, projekt, adres w pasku, pikselowy).
const uiShots: [string, string, number, number, string, string, boolean][] = [
  ['agenci', '/img/projekty/panel-agenci.webp', 1440, 790, 'agenci-ai', 'my.gitcloud · agenci', false],
  ['modele', '/img/projekty/panel-modele.webp', 1440, 985, 'panel-operacyjny', 'my.gitcloud · modele', false],
  ['pulpit', '/img/projekty/pulpit-okladka.webp', 1280, 720, 'pulpit-gitcloud', 'pulpit gitcloud', false],
  ['pilot', '/img/projekty/pilot-kafelki.png', 1280, 680, 'pilot-esp32', 'pilot esp32 · 320×170', true],
  ['isp', '/img/demo/dashboard.webp', 2000, 1250, 'platforma-isp', 'demo.gitcloud · dashboard', false],
];
// Żywa architektura: powiązania elementów warstw (L3 interfejs, L2 agenci, L1 dane), indeksy jak w T.arch.layers.
const archLinks: [string, string][] = [
  ['L3-0', 'L2-0'], ['L3-0', 'L2-1'], ['L3-0', 'L2-2'], ['L3-0', 'L1-1'],
  ['L3-1', 'L2-0'], ['L3-1', 'L2-1'],
  ['L3-2', 'L2-0'], ['L3-2', 'L1-1'],
  ['L2-0', 'L1-1'], ['L2-0', 'L1-2'], ['L2-1', 'L1-0'], ['L2-2', 'L1-0'],
];
const kpiVals = [`${stats.exam}%`, `${stats.years}+`];
const agentMeta = [['Sally', 'sally', 'm'], ['Tony', 'tony', 'b'], ['Mark', 'mark', 'g']];
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE}/#website`, name: 'GitCloud', alternateName: T.ld.altNames, url: URL0, inLanguage: T.inLanguage, publisher: { '@id': `${SITE}/#org` } },
    { '@type': ['Organization', 'ProfessionalService'], '@id': `${SITE}/#org`, name: 'GitCloud', url: `${SITE}/`, logo: `${SITE}/favicon-192.png`, email: `mailto:${EMAIL}`, areaServed: 'PL', description: T.ld.orgDesc, founder: { '@id': `${SITE}/#aleh` } },
    { '@type': 'Person', '@id': `${SITE}/#aleh`, name: 'Aleh Pauliukovich', url: `${SITE}/`, image: `${SITE}/img/aleh.jpg`, jobTitle: T.ld.job, knowsAbout: T.ld.knows, knowsLanguage: ['pl', 'ru', 'be', 'en'], hasCredential: { '@type': 'EducationalOccupationalCredential', name: 'Oracle Cloud Infrastructure Certified AI Foundations Associate', credentialCategory: 'certification', recognizedBy: { '@type': 'Organization', name: 'Oracle' } }, worksFor: { '@id': `${SITE}/#org` } },
    { '@type': 'ItemList', name: T.ld.list, itemListElement: ordered.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}${projectPath(p.slug, lang)}`, name: p.title })) },
    { '@type': 'FAQPage', mainEntity: T.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
---
<Base title={T.meta.title} description={T.meta.description} jsonld={jsonld} lang={lang} path={home(lang)} alternates>
  <script is:inline slot="head">
    // Stare kotwice (/#platforma, /#operator …) → nowe sekcje.
    // Kotwica, odświeżenie, wstecz: przewijanie potrzebuje prawdziwych wysokości sekcji → bez content-visibility (site.css).
    (function () { var n = performance.getEntriesByType && performance.getEntriesByType('navigation')[0]; if (location.hash || (n && n.type !== 'navigate')) document.documentElement.classList.add('cv-off'); if ('scrollRestoration' in history) history.scrollRestoration = 'manual'; })();
    (function () { var h = location.hash.slice(1); if (/^(platforma|mozliwosci|zalozyciel|stat-grid|sw-[a-z]+)$/.test(h)) history.replaceState(null, '', '#konsola'); if (h === 'operator') history.replaceState(null, '', '#doswiadczenie'); })();
  </script>

  <!-- ═══ 00 · HERO ═══ -->
  <section class="hero" id="ekosystem">
    <div class="wrap hero-in">
      <div class="hero-txt">
        <h1>{T.hero.h1a}<span class="hl">{T.hero.h1b}</span>{T.hero.h1c}</h1>
        <p class="lead">{T.hero.lead}</p>
        <div class="actions">
          <a class="btn btn-p" href="#moduly">{T.hero.cta1}</a>
          <a class="btn btn-g" href="#kontakt">{T.hero.cta2}</a>
        </div>
      </div>
      <EcoMap lang={lang} />
    </div>
    <div class="wrap">
      <ul class="kpis">
        {kpiVals.map((v, i) => (
          <li class="tile"><span class="lbl">{T.kpis[i][0]}</span><b class="val mono">{v}</b><span class="sub">{T.kpis[i][1]}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ 01 · ARCHITEKTURA ═══ -->
  <section class="sec" id="architektura">
    <div class="wrap">
      <header class="sec-h">
        <span class="idx mono">{T.arch.idx}</span>
        <h2>{T.arch.h2}</h2>
        <p>{T.arch.p}</p>
      </header>
      <div class="stack" data-links={JSON.stringify(archLinks)}>
        <svg class="arch-wires" aria-hidden="true"></svg>
        {T.arch.layers.map(([lt, ls, items], li) => (
          <div class={`layer layer-L${3 - li}`}>
            <div class="layer-h"><span class="mono layer-k">L{3 - li}</span><div><h3>{lt}</h3><span class="muted">{ls}</span></div></div>
            <ul class="layer-items">
              {items.map(([it, isub], ii) => (
                <li data-k={`L${3 - li}-${ii}`}>{layerLinks[li][ii] ? <a href={layerLinks[li][ii]}><b>{it}</b><span>{isub}</span></a> : <div><b>{it}</b><span>{isub}</span></div>}</li>
              ))}
            </ul>
          </div>
        ))}
        <div class="flow mono" aria-hidden="true">
          {T.arch.flow.map((f, i) => <>{i === 3 && <b class="flow-br"></b>}{i > 0 && <i></i>}<span>{f}</span></>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 02 · REALIZACJE ═══ -->
  <section class="sec" id="moduly">
    <div class="wrap">
      <header class="sec-h">
        <span class="idx mono">{T.mod.idx}</span>
        <h2>{T.mod.h2}</h2>
        <p>{T.mod.p}</p>
      </header>
      <div class="filters pills" role="toolbar" aria-label={T.mod.filterAria}>
        <button type="button" class="is-on" data-f="all">{T.mod.all} <span class="mono">{projects.length}</span></button>
        {Object.entries(categories).map(([k, v]) => count(k) > 0 && <button type="button" data-f={k}>{v} <span class="mono">{count(k)}</span></button>)}
      </div>
      <div class="bento">
        {ordered.map((p, i) => <ProjectCard p={p} big={i < 3} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- ═══ 03 · INTERFEJSY (kotwica #konsola zostaje dla starych linków) ═══ -->
  <section class="sec" id="konsola">
    <div class="wrap">
      <header class="sec-h">
        <span class="idx mono">{T.console.idx}</span>
        <h2>{T.console.h2}</h2>
        <p>{T.console.p}</p>
      </header>
      <div class="console">
        <div class="console-bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="mono url" id="shot-name">{uiShots[0][5]}</span>
        </div>
        <div class="pills console-tabs" role="tablist" aria-label={T.console.tabsAria}>
          {uiShots.map(([k, , , , , u], i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} class={i === 0 ? 'is-on' : ''} data-shot={k} data-url={u}>{T.console.shots[k][0]}</button>
          ))}
        </div>
        <div class="console-view">
          {uiShots.map(([k, src, w, h, , , px], i) => (
            <figure class={`shot${i === 0 ? ' is-on' : ''}`} data-shot={k} role="tabpanel">
              <a class="shot-img" href={src} target="_blank" rel="noopener" aria-label={`${T.console.open}: ${T.console.shots[k][0]}`}><img class={px ? 'px' : undefined} src={src} alt={`${T.console.alt}: ${T.console.shots[k][0]} (${T.console.altDemo})`} width={w} height={h} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></a>
            </figure>
          ))}
        </div>
        <div class="console-cap">
          {uiShots.map(([k, , , , p], i) => (
            <p class={`shot-cap${i === 0 ? ' is-on' : ''}`} data-shot={k}>{T.console.shots[k][1]} {has(p) && <a href={`#${anchor(p)}`}>{T.console.more} &rarr;</a>}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 04 · AGENCI ═══ -->
  <section class="sec" id="agenci">
    <div class="wrap">
      <header class="sec-h">
        <span class="idx mono">{T.agents.idx}</span>
        <h2>{T.agents.h2}</h2>
        <p>{T.agents.p}</p>
      </header>
      <div class="agents">
        {agentMeta.map(([n, f, c], i) => (
          <article class={`agent agent-${c}`}>
            <div class="agent-media">
              <img src={`/img/agenci/${f}.webp`} alt={`${n}: ${T.agents.alt}`} width="320" height="320" loading="lazy" decoding="async" />
              <span class="agent-tag mono">● {f}.agent</span>
            </div>
            <div class="agent-body">
              <h3>{n}</h3>
              <span class="agent-role mono">{T.agents.list[i][0]}</span>
              <p>{T.agents.list[i][1]}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="agent-links">
        {has('agenci-ai') && <a class="link-more" href={`#${anchor('agenci-ai')}`}>{T.agents.more1} &rarr;</a>}
        {has('glowy-agentow') && <a class="link-more" href={`#${anchor('glowy-agentow')}`}>{T.agents.more2} &rarr;</a>}
      </div>
    </div>
  </section>

  <!-- ═══ 05 · USŁUGI ═══ -->
  <section class="sec" id="uslugi">
    <div class="wrap">
      <header class="sec-h">
        <span class="idx mono">{T.svc.idx}</span>
        <h2>{T.svc.h2}</h2>
        <p>{T.svc.p}</p>
      </header>
      <div class="areas">
        {T.svc.areas.map(([at, ad], i) => <div class="area"><span class="mono area-n">0{i + 1}</span><b>{at}</b><span>{ad}</span></div>)}
      </div>
      <div class="svc">
        <div class="prices">
          {T.svc.prices.map(([pt, ps]) => <div class="tile deal"><b>{pt}</b><span class="sub">{ps}</span></div>)}
        </div>
        <ol class="steps">
          {T.svc.steps.map(([st, ss], i) => <li><span class="mono step-n">{i + 1}</span><div><b>{st}</b><span>{ss}</span></div></li>)}
        </ol>
      </div>
      <a class="link-more" href={dyzPath(lang)}>{DYZ[lang].more}: {DYZ[lang].prices[0][0]} + {DYZ[lang].prices[1][0]} &rarr;</a>
      {count('zlecenia') > 0 && <a class="link-more" href="#moduly" data-filtr="zlecenia">{T.svc.more} &rarr;</a>}
      <a class="link-more" href={stats.useme.url} rel="noopener">{T.svc.useme(stats.useme.contracts, stats.useme.done, stats.useme.disputed)} &rarr;</a>
    </div>
  </section>

  <!-- ═══ 06 · DOŚWIADCZENIE I KOMPETENCJE ═══ -->
  <section class="sec" id="doswiadczenie">
    <span id="operator" aria-hidden="true"></span>
    <div class="wrap">
      <div class="who">
        <div class="who-photo"><img src="/img/aleh.jpg" alt="Aleh Pauliukovich" width="560" height="560" loading="lazy" decoding="async" /></div>
        <div class="who-txt">
          <span class="idx mono">{T.exp.idx}</span>
          <h2>{T.exp.h2}</h2>
          {T.exp.bio.map((b) => <p>{b}</p>)}
          <a class="btn btn-g btn-sm cv-btn" href={T.cv.file} download><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"/></svg> {T.exp.cv}</a>
        </div>
      </div>

      <div class="exp">
        <div class="exp-roles">
          <h3 class="lbl">{T.exp.rolesTitle}</h3>
          <ol class="timeline">
            {T.exp.roles.map(([when, role, where, pts]) => (
              <li>
                <span class="tl-when mono">{when}</span>
                <div class="tl-body">
                  <b>{role}</b><span class="tl-where">{where}</span>
                  <ul>{pts.map((x) => <li>{x}</li>)}</ul>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="exp-skills">
          <h3 class="lbl">{T.exp.skillsTitle}</h3>
          <div class="skills">
            {T.exp.skills.map(([g, items]) => (
              <div class="skill">
                <b>{g}</b>
                <div class="tags">{items.map((x) => <span>{x}</span>)}</div>
              </div>
            ))}
          </div>
          <div class="exp-side">
            <div class="tile">
              <span class="lbl">{T.exp.certTitle}</span>
              <ul class="certs">{T.exp.certs.map(([cn, cd]) => <li><b>{cn}</b><span>{cd}</span></li>)}</ul>
            </div>
            <div class="tile">
              <span class="lbl">{T.exp.langsTitle}</span>
              <ul class="langs-list">{T.exp.langs.map(([ln, lv]) => <li><span>{ln}</span><b class="mono">{lv}</b></li>)}</ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ZMIANY (decyzja #748): trzy ostatnie wpisy dziennika, prowadzi go nocne odświeżanie ═══ -->
  <section class="sec zm-home" id="zmiany">
    <div class="wrap">
      <span class="idx mono">{T.ui.changesH}</span>
      <ol class="zm-list">
        {zmiany.slice(0, 3).map((z) => { const tx = (z as any)[lang] ?? z.pl; return (
          <li class="zm-item tile"><div class="zm-meta mono"><time datetime={z.date}>{z.date}</time></div>
            <h3>{tx.t}</h3></li>); })}
      </ol>
      <a class="link-more" href={zmianyPath(lang)}>{T.ui.changesAll} &rarr;</a>
    </div>
  </section>

  <!-- ═══ 07 · KONTAKT ═══ -->
  <section class="sec" id="kontakt">
    <div class="wrap"><div class="contact">
      <div class="contact-main">
        <span class="idx mono">{T.contact.idx}</span>
        <h2>{T.contact.h2}</h2>
        <p>{T.contact.p}</p>
        <div class="mail">
          <a class="btn btn-p btn-lg" href={`mailto:${EMAIL}`}>{T.contact.btn} &rarr;</a>
          <button type="button" class="btn btn-g mono copy" data-copy={EMAIL} aria-label={T.contact.copyAria}>{EMAIL}</button>
        </div>
      </div>
      <div class="faq">
        {T.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div></div>
  </section>

  {/* Okna projektów w <template>: DOM i obrazy powstają dopiero przy pierwszym otwarciu (połowa HTML głównej). */}
  {ordered.map((p) => <template data-pd={anchor(p.slug)}><ProjectDialog p={p} lang={lang} /></template>)}
  <div class="toast mono" id="toast" role="status" aria-live="polite"></div>
</Base>

<script>
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s);
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<T>(s));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Pozycja przy odświeżeniu / wstecz: zapisana w history.state i przywracana przez stronę (head ustawia scrollRestoration
  //    = manual). Chrome po odświeżeniu odtwarzał pozycję z układu z content-visibility i lądował kilka ekranów wyżej.
  const saveY = () => { try { history.replaceState({ ...(history.state || {}), gcY: Math.round(scrollY) }, ''); } catch {} };
  let saveT: number | undefined;
  addEventListener('scroll', () => { clearTimeout(saveT); saveT = window.setTimeout(saveY, 200); }, { passive: true });
  const nav = performance.getEntriesByType?.('navigation')[0] as PerformanceNavigationTiming | undefined;
  const y0 = history.state?.gcY;
  if (nav && nav.type !== 'navigate' && typeof y0 === 'number') scrollTo({ top: y0, behavior: 'instant' });

  // ── Klik w kotwicę na tej stronie: najpierw ułożyć wszystkie sekcje (cv-off), potem przeglądarka liczy cel przewijania.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
    if (a && a.pathname === location.pathname && a.hash) document.documentElement.classList.add('cv-off');
  }, true);

  // ── Okna projektów: #p-<slug> otwiera okno (link z zewnątrz też), zamknięcie czyści adres.
  const wire = (d: HTMLDialogElement) => {
    d.addEventListener('close', () => {
      if (location.hash === '#' + d.id) history.replaceState(history.state, '', location.pathname + location.search);
      $$('video', d).forEach((v) => (v as HTMLVideoElement).pause());
    });
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    $$('[data-close]', d).forEach((b) => b.addEventListener('click', () => d.close()));
    // galeria w oknie
    const big = $<HTMLImageElement>('.pd-big img', d), bigV = $<HTMLVideoElement>('.pd-big video', d), cap = $('.pd-big figcaption', d);
    $$<HTMLButtonElement>('.pd-thumbs button', d).forEach((b) => b.addEventListener('click', () => {
      $$('.pd-thumbs button', d).forEach((x) => x.classList.toggle('is-on', x === b));
      const { src, tel, video, alt, px } = b.dataset;
      if (bigV) {
        if (video) { bigV.hidden = false; bigV.poster = src!; bigV.src = video; bigV.play().catch(() => {}); if (big) big.hidden = true; }
        else { bigV.pause(); bigV.hidden = true; if (big) big.hidden = false; }
      }
      // srcset pierwszego obrazu (wersja 960 px) ma pierwszeństwo przed src, więc przy zmianie obrazu go zdejmujemy
      if (big && !video) { big.removeAttribute('srcset'); big.src = src!; big.alt = alt || ''; big.classList.toggle('px', px === '1'); let so = big.parentElement?.querySelector('source'); if (tel) { if (!so) { so = document.createElement('source'); so.media = '(max-width: 600px)'; big.before(so); } so.srcset = tel; } else so?.remove(); }
      if (cap) cap.textContent = alt || '';
    }));
  };
  // Okno z <template data-pd> wstawiane przy pierwszym otwarciu; potem zostaje w dokumencie.
  const dialog = (id: string) => {
    const got = document.getElementById(id) as HTMLDialogElement | null;
    if (got) return got;
    const t = $<HTMLTemplateElement>(`template[data-pd="${id}"]`);
    const d = t?.content.firstElementChild?.cloneNode(true) as HTMLDialogElement | undefined;
    if (!t || !d) return null;
    t.replaceWith(d); wire(d);
    return d;
  };
  const openFromHash = () => {
    const h = decodeURIComponent(location.hash.slice(1));
    $$<HTMLDialogElement>('dialog.pd[open]').forEach((d) => { if (d.id !== h) d.close(); });
    if (!h.startsWith('p-')) return;
    const d = dialog(h);
    if (d && !d.open) {
      d.showModal();
      d.querySelector<HTMLElement>('.pd-body')?.scrollTo(0, 0);
    }
  };
  addEventListener('hashchange', openFromHash);
  openFromHash();

  // ── Filtr modułów
  $$<HTMLButtonElement>('.filters button').forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    $$('.filters button').forEach((x) => x.classList.toggle('is-on', x === b));
    $$<HTMLElement>('.bento .card').forEach((c) => { c.hidden = !(f === 'all' || c.dataset.cat === f); });
  }));
  // „Zrealizowane zlecenia” w Usługach: przewija do modułów z włączonym filtrem zleceń
  $$<HTMLAnchorElement>('a[data-filtr]').forEach((a) => a.addEventListener('click', () => {
    $$<HTMLButtonElement>('.filters button').find((b) => b.dataset.f === a.dataset.filtr)?.click();
  }));

  // ── Karuzele na telefonie: klasa is-end, gdy nie ma już nic dalej (zdejmuje wygaszenie prawego brzegu)
  $$<HTMLElement>('.layer-items, .agents, .areas').forEach((c) => {
    const end = () => c.classList.toggle('is-end', c.scrollLeft + c.clientWidth >= c.scrollWidth - 4);
    c.addEventListener('scroll', end, { passive: true }); addEventListener('resize', end); end();
  });

  // ── Konsola: zakładki widoków
  const tabs = $$<HTMLButtonElement>('.console-tabs button');
  const show = (k: string) => {
    tabs.forEach((t) => { const on = t.dataset.shot === k; t.classList.toggle('is-on', on); t.setAttribute('aria-selected', String(on)); });
    $$<HTMLElement>('.console .shot, .console .shot-cap').forEach((s) => s.classList.toggle('is-on', s.dataset.shot === k));
    const n = $('#shot-name'), t = tabs.find((x) => x.dataset.shot === k); if (n && t) n.textContent = t.dataset.url || k;
  };
  tabs.forEach((t) => t.addEventListener('click', () => { show(t.dataset.shot!); stopAuto(); }));
  let auto: number | undefined;
  const stopAuto = () => { if (auto) clearInterval(auto); auto = undefined; };
  const consoleEl = $('.console');
  if (consoleEl && !reduce) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && auto === undefined && tabs.length) {
        auto = window.setInterval(() => {
          const i = tabs.findIndex((t) => t.classList.contains('is-on'));
          show(tabs[(i + 1) % tabs.length].dataset.shot!);
        }, 5200);
      } else if (!e.isIntersecting) stopAuto();
    }, { threshold: 0.4 }).observe(consoleEl);
    consoleEl.addEventListener('pointerenter', stopAuto);
  }

  // ── Wideo gra tylko na ekranie
  const vio = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLVideoElement;
    if (e.isIntersecting && !reduce) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
  }), { threshold: 0.35 });
  $$<HTMLVideoElement>('video[data-inview]').forEach((v) => vio.observe(v));

  // ── Aktywna sekcja w menu
  const spy = $$<HTMLAnchorElement>('a[data-spy]');
  const sio = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) spy.forEach((a) => a.classList.toggle('is-on', a.dataset.spy === e.target.id));
  }), { rootMargin: '-45% 0px -50% 0px' });
  new Set(spy.map((a) => a.dataset.spy!)).forEach((id) => { const s = document.getElementById(id); if (s) sio.observe(s); });

  // ── Pojawianie się bloków
  if (!reduce) {
    const rio = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); rio.unobserve(e.target); } }), { threshold: 0.12 });
    $$('.sec-h, .layer, .bento .card, .console, .agent, .areas, .svc, .who > *, .contact > *').forEach((el) => { el.classList.add('rv'); rio.observe(el); });
  }

  // ── Żywa architektura: najechanie (lub dotknięcie) elementu warstwy podświetla jego powiązania i rysuje przewody.
  const stack = $<HTMLElement>('.stack[data-links]');
  if (stack) {
    const links: [string, string][] = JSON.parse(stack.dataset.links || '[]');
    const wires = $<SVGSVGElement>('.arch-wires', stack)!;
    const items = $$<HTMLElement>('li[data-k]', stack);
    const byK = new Map(items.map((li) => [li.dataset.k!, li]));
    const nb = (k: string) => links.filter((l) => l.includes(k)).map(([a, b]) => (a === k ? b : a));
    const clear = () => { stack.classList.remove('is-hl'); items.forEach((li) => li.classList.remove('is-src', 'is-rel')); wires.innerHTML = ''; };
    const light = (k: string) => {
      clear();
      const src = byK.get(k); if (!src) return;
      stack.classList.add('is-hl'); src.classList.add('is-src');
      const rel = nb(k);
      rel.forEach((r) => byK.get(r)?.classList.add('is-rel'));
      // przewody tylko w układzie siatki (na telefonie warstwy są karuzelami)
      if (matchMedia('(min-width:861px)').matches) {
        const box = stack.getBoundingClientRect();
        wires.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
        const pt = (el: HTMLElement, up: boolean) => { const r = el.getBoundingClientRect(); return [r.left + r.width / 2 - box.left, (up ? r.top : r.bottom) - box.top]; };
        wires.innerHTML = rel.map((r) => {
          const el = byK.get(r)!; const down = r.slice(1, 2) < k.slice(1, 2);
          const [x1, y1] = pt(src, !down), [x2, y2] = pt(el, down);
          const my = (y1 + y2) / 2;
          return `<path d="M${x1} ${y1} C${x1} ${my} ${x2} ${my} ${x2} ${y2}"/><circle cx="${x2}" cy="${y2}" r="3.5"/>`;
        }).join('');
      }
    };
    items.forEach((li) => {
      li.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') light(li.dataset.k!); });
      li.addEventListener('focusin', () => light(li.dataset.k!));
      li.addEventListener('click', (e) => { if (!li.querySelector('a') && !li.classList.contains('is-src')) { e.preventDefault(); light(li.dataset.k!); } });
    });
    stack.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse') clear(); });
    stack.addEventListener('focusout', (e) => { if (!stack.contains((e as FocusEvent).relatedTarget as Node)) clear(); });
    items.forEach((li) => { const d = li.firstElementChild as HTMLElement | null; if (d && d.tagName === 'DIV') d.tabIndex = 0; });
    addEventListener('resize', clear);
  }

  // ── Mapa ekosystemu: najechany węzeł podświetla swoją ścieżkę do rdzenia
  const eco = $<SVGSVGElement>('.eco svg');
  if (eco) $$<SVGAElement>('.eco-node', eco).forEach((n, i) => {
    const on = (v: boolean) => { eco.classList.toggle('is-hl', v); $(`#eco-p${i}`, eco)?.classList.toggle('on', v); n.classList.toggle('on', v); };
    n.addEventListener('pointerenter', () => on(true)); n.addEventListener('pointerleave', () => on(false));
    n.addEventListener('focus', () => on(true)); n.addEventListener('blur', () => on(false));
  });

  // ── Kopiowanie adresu
  const toast = $('#toast');
  document.addEventListener('gc-toast', () => { if (toast) { toast.textContent = document.body.dataset.copied || ''; toast.classList.add('on'); setTimeout(() => toast.classList.remove('on'), 1800); } });
  $$<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); if (toast) { toast.textContent = document.body.dataset.copied || ''; toast.classList.add('on'); setTimeout(() => toast.classList.remove('on'), 1800); } }
    catch { location.href = 'mailto:' + b.dataset.copy; }
  }));
</script>
