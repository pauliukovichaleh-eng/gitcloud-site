---
import { anchor, plakat, type Project } from '../lib/data';
import { t, type Lang } from '../i18n';
interface Props { p: Project; big?: boolean; lang?: Lang; href?: string }
const { p, big = false, lang = 'pl', href } = Astro.props;
const M = t(lang).mod;
const categories = M.categories as Record<string, string>;
const media = p.video ? 'video' : p.image ? 'img' : 'gen';
---
<a class={`card cat-${p.category}${big ? ' card-big' : ''}`} href={href || `#${anchor(p.slug)}`} data-cat={p.category}>
  <div class={`card-media m-${media}`}>
    {media === 'video' && <img class="card-poster" src={plakat(p.video!.poster)} alt="" loading="lazy" decoding="async" />}
    {media === 'video' && <video src={p.video!.src} muted loop playsinline preload="none" width="960" height="474" aria-label={p.image_alt || p.title} data-inview></video>}
    {media === 'img' && <img src={p.image} alt={p.image_alt || p.title} class={p.pixelated ? 'px' : ''} loading="lazy" decoding="async" />}
    {media === 'gen' && (
      <div class="gen" aria-hidden="true">
        <span class="gen-big mono">{p.badge || p.stack[0]}</span>
        <span class="gen-sub mono">{p.stages ? `${p.stages.length} ${M.deliveries} · ${p.stack.slice(0, 2).join(' · ')}` : p.stack.slice(1, 4).join(' · ')}</span>
      </div>
    )}
    <span class="card-cat mono">{categories[p.category]}{p.year ? ` · ${p.year}` : ''}</span>
  </div>
  <div class="card-body">
    <h3>{p.title}</h3>
    <p>{p.lead}</p>
    {p.results?.[0] && <div class="card-res mono"><span class="dot ok"></span>{p.results[0]}</div>}
    <div class="tags">{p.stack.slice(0, 5).map((s) => <span>{s}</span>)}</div>
  </div>
</a>
