---
// Stary adres z wcześniejszej wersji strony: przekierowanie do sekcji jednostronicowej wizytówki.
interface Props { to: string }
const { to } = Astro.props;
---
<!doctype html>
<html lang="pl"><head><meta charset="utf-8"><title>GitCloud</title>
<meta name="robots" content="noindex, follow"><link rel="canonical" href="https://gitcloud.pl/">
<meta http-equiv="refresh" content={`0; url=${to}`}>
<script is:inline define:vars={{ to }}>location.replace(to + (location.hash && to.indexOf('#') < 0 ? location.hash : ''));</script>
</head><body style="background:#05070c;color:#d9e1ff;font-family:system-ui"><p><a href={to} style="color:#5aa4ff">gitcloud.pl</a></p></body></html>
