---
import '../styles/fonts.css'; // lekkie podzbiory, tools/fonty.py
import '../styles/core.css';
import '../styles/site.css';
import Mark from '../components/Mark.astro';
import Palette from '../components/Palette.astro';
import { build } from '../lib/build';
import fonty from '../data/fonty.json'; // tools/fonty.py
import { t, LANGS, LABEL, home, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonld?: object;
  nav?: boolean;
  noindex?: boolean;
  lang?: Lang;
  alternates?: boolean; // strona istnieje w trzech językach (hreflang + przełącznik)
  altPaths?: Partial<Record<Lang, string>>; // adresy wersji językowych, gdy to nie strona główna
  og?: string; // obraz og:image (domyślnie karta strony głównej w danym języku, tools/render.mjs)
}
const { title, description, path = '/', jsonld, nav = true, noindex = false, lang = 'pl', alternates = false, altPaths, og: ogPath } = Astro.props;
const alt = (l: Lang) => altPaths?.[l] || home(l);
const privacyHref = lang === 'pl' ? '/privacy.html' : `/${lang}/privacy.html`;
const changesHref = lang === 'pl' ? '/zmiany/' : `/${lang}/zmiany/`;
const T = t(lang);
const url = new URL(path, Astro.site).href;
const og = new URL(ogPath || `/img/og/home-${lang}.png`, Astro.site).href;
const base = home(lang);
const tabIcons: Record<string, string> = {
  ekosystem: '<path d="M20.5 7.2 12 2.5 3.5 7.2v9.6l8.5 4.7 8.5-4.7V12H13"/>',
  moduly: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>',
  agenci: '<rect x="5" y="7" width="14" height="11" rx="3"/><path d="M12 3v4M9 12h.01M15 12h.01M2.5 12v3M21.5 12v3"/>',
  uslugi: '<path d="M14.7 6.3a4 4 0 0 0 5 5L21 13l-8 8-3-3 8-8M9.3 17.7l-6 -6 3-3 6 6"/>',
  doswiadczenie: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  kontakt: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
};
const tabIds = ['ekosystem', 'moduly', 'agenci', 'uslugi', 'doswiadczenie', 'kontakt'];
const locale = lang === 'pl' ? 'pl-PL' : lang === 'ru' ? 'ru-RU' : 'en-GB';
---
<!doctype html>
<html lang={T.htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{fonty[lang].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
{alternates && LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(alt(l), Astro.site).href} />)}
{alternates && <link rel="alternate" hreflang="x-default" href={new URL(alt('pl'), Astro.site).href} />}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}>
<meta name="author" content="Aleh Pauliukovich">
<meta name="theme-color" content="#030408">
<meta name="color-scheme" content="dark">
<meta property="og:type" content="website">
<meta property="og:url" content={url}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content={T.locale}>
{alternates && LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={t(l).locale} />)}
<meta property="og:site_name" content="GitCloud">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/favicon-192.png">
<link rel="sitemap" href="/sitemap.xml">
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<slot name="head" />
</head>
<body data-copied={T.ui.copied}>
<div class="bg" aria-hidden="true"><i class="bg-glow"></i><i class="bg-grid"></i></div>
<a class="skip" href="#main">{T.ui.skip}</a>
<header class="top">
  <div class="wrap top-in">
    <a class="brand" href={base} aria-label={T.ui.home}>
      <Mark size={30} />
      <span class="brand-t"><b>Git</b>Cloud<i>.pl</i></span>
    </a>
    {nav && (
      <nav class="pills" aria-label={T.ui.navAria}>
        {T.nav.map(([id, label]) => <a href={`#${id}`} data-spy={id}>{label}</a>)}
      </nav>
    )}
    <div class="top-r">
      <span class="clock mono" aria-hidden="true"><span id="gc-date">--.--.----</span> <b id="gc-time">--:--:--</b></span>
      {alternates && (
        <nav class="langs mono" aria-label={T.ui.langAria}>
          {LANGS.map((l) => <a href={alt(l)} hreflang={l} lang={l} class={l === lang ? 'is-on' : ''} aria-current={l === lang ? 'page' : undefined}>{LABEL[l]}</a>)}
        </nav>
      )}
      <button type="button" class="pal-btn" data-pal aria-label={T.ui.searchAria} title={T.ui.searchAria}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
        <span class="pal-btn-t">{T.ui.search}</span><kbd class="mono">Ctrl K</kbd>
      </button>
      <a class="btn btn-sm btn-p top-cta" href={nav ? '#kontakt' : `${base}#kontakt`}>{T.ui.contact}</a>
    </div>
  </div>
</header>
{nav && (
  <nav class="tabbar" aria-label={T.ui.tabAria}>
    {tabIds.map((id, i) => <a href={`#${id}`} data-spy={id}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={tabIcons[id]} /><span>{T.tabs[i]}</span></a>)}
  </nav>
)}
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap foot-in">
    <div class="foot-brand"><Mark size={22} /> <span>© {new Date().getFullYear()} GitCloud · Aleh Pauliukovich</span></div>
    <div class="foot-sys mono"><span class="dot ok"></span> {T.ui.footSys}</div>
    <a href={changesHref}>{T.ui.changes}</a>
    <a href={privacyHref}>{T.ui.privacy}</a>
    <span class="foot-build mono">{T.ui.build} {build.url ? <a href={build.url} rel="noopener">{build.short}</a> : build.short} · <time datetime={build.at.replace(' ', 'T')}>{build.at}</time></span>
  </div>
</footer>
<Palette lang={lang} altPaths={altPaths} />
<script define:vars={{ locale }}>
  // Zegar w strefie Warszawy, jak w nagłówku konsoli GitCloud.
  const d = document.getElementById('gc-date'), tm = document.getElementById('gc-time');
  const fd = new Intl.DateTimeFormat(locale, { timeZone: 'Europe/Warsaw', day: '2-digit', month: '2-digit', year: 'numeric' });
  const ft = new Intl.DateTimeFormat(locale, { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit', second: '2-digit' });
  const tick = () => { const n = new Date(); if (d) d.textContent = fd.format(n); if (tm) tm.textContent = ft.format(n); };
  tick(); setInterval(tick, 1000);
</script>
</body>
</html>
