---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/site.css';
import Mark from '../components/Mark.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonld?: object;
  nav?: boolean;
  noindex?: boolean;
}
const { title, description, path = '/', jsonld, nav = true, noindex = false } = Astro.props;
const url = new URL(path, Astro.site).href;
const og = new URL('/img/og.jpg', Astro.site).href;
const links = [
  ['#ekosystem', 'Ekosystem'],
  ['#moduly', 'Moduły'],
  ['#konsola', 'Konsola ISP'],
  ['#agenci', 'Agenci'],
  ['#uslugi', 'Usługi'],
  ['#operator', 'Operator'],
];
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}>
<meta name="author" content="Aleh Pauliukovich">
<meta name="theme-color" content="#05070c">
<meta name="color-scheme" content="dark">
<meta property="og:type" content="website">
<meta property="og:url" content={url}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="pl_PL">
<meta property="og:site_name" content="GitCloud">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/favicon-192.png">
<link rel="sitemap" href="/sitemap.xml">
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<slot name="head" />
</head>
<body>
<div class="bg" aria-hidden="true"><i class="bg-glow"></i><i class="bg-grid"></i><i class="bg-rain"></i></div>
<a class="skip" href="#main">Przejdź do treści</a>
<header class="top">
  <div class="wrap top-in">
    <a class="brand" href="/" aria-label="GitCloud, strona główna">
      <Mark size={30} />
      <span class="brand-t"><b>Git</b>Cloud<i>.pl</i></span>
    </a>
    {nav && (
      <nav class="pills" aria-label="Sekcje">
        {links.map(([h, t]) => <a href={h} data-spy={h.slice(1)}>{t}</a>)}
      </nav>
    )}
    <div class="top-r">
      <span class="clock mono" aria-hidden="true"><span id="gc-date">--.--.----</span> <b id="gc-time">--:--:--</b></span>
      <a class="btn btn-sm btn-p" href={nav ? '#kontakt' : '/#kontakt'}>Kontakt</a>
    </div>
  </div>
</header>
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap foot-in">
    <div class="foot-brand"><Mark size={22} /> <span>© {new Date().getFullYear()} GitCloud · Aleh Pauliukovich</span></div>
    <div class="foot-sys mono"><span class="dot ok"></span> statyczna strona · bez ciasteczek i analityki · Astro + GitHub Pages</div>
    <a href="/privacy.html">Polityka prywatności</a>
  </div>
</footer>
<script>
  // Zegar w strefie Warszawy, jak w nagłówku konsoli GitCloud.
  const d = document.getElementById('gc-date'), t = document.getElementById('gc-time');
  const fd = new Intl.DateTimeFormat('pl-PL', { timeZone: 'Europe/Warsaw', day: '2-digit', month: '2-digit', year: 'numeric' });
  const ft = new Intl.DateTimeFormat('pl-PL', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit', second: '2-digit' });
  const tick = () => { const n = new Date(); if (d) d.textContent = fd.format(n); if (t) t.textContent = ft.format(n); };
  tick(); setInterval(tick, 1000);
</script>
</body>
</html>
